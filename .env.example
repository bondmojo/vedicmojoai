# Database
DATABASE_URL=postgresql://vedicmojo:vedicmojo_dev@localhost:5432/vedicmojoai?schema=public

# AI Provider Keys
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here          # optional
GOOGLE_AI_API_KEY=your_key_here       # optional

# Application
REPORTS_DIR=./data/reports

# Auth (user-management feature — see .kiro/specs/user-management/)
AUTH_SECRET=generate_with_npx_auth_secret        # `npx auth secret` or `openssl rand -base64 33`
RESEND_API_KEY=your_resend_key_here              # password-reset emails
RESEND_FROM_EMAIL=noreply@yourdomain.com         # verified sending domain in Resend
MCP_DEV_USER_EMAIL=                              # optional, non-production only: MCP identity when no x-mcp-token is sent
COOKIE_SECURE=false                              # "true" ONLY when served over real HTTPS (e.g. behind a TLS-terminating
                                                  # reverse proxy). NOT tied to NODE_ENV — a Secure cookie is silently
                                                  # dropped by the browser over plain HTTP, breaking login entirely.
                                                  # Leave false for local dev and this repo's own docker-compose (no TLS).
AUTH_TRUST_HOST=true                              # Required whenever NODE_ENV=production and this isn't Vercel/Cloudflare
                                                  # Pages (docker-compose.yml sets this for you already). Auth.js's
                                                  # trustHost only defaults true in development; without it every
                                                  # auth() call throws "UntrustedHost" and all auth breaks in prod.

# MCP over HTTP (POST /api/mcp — the remote transport; see mcp/README.md)
VEDICMOJO_INTERNAL_BASE_URL=                     # Origin the /api/mcp route uses for its self-referential calls into
                                                  # this same app's /api/* routes. Leave EMPTY for local dev and
                                                  # docker-compose (falls back to the request's own origin).
                                                  # SET IT on any deployment behind a proxy (Vercel): the fallback is
                                                  # derived from x-forwarded-host, i.e. the PUBLIC hostname, so
                                                  # self-calls would leave and re-enter over the internet — slower,
                                                  # double-billed, and 401'd outright by Vercel Deployment Protection.
VERCEL_AUTOMATION_BYPASS_SECRET=                 # Only if Deployment Protection stays on (default for Vercel preview
                                                  # deployments): forwarded as x-vercel-protection-bypass so the
                                                  # route's self-calls aren't answered with a login page.

# MCP OAuth authorization server (app/.well-known/**, app/oauth/authorize,
# app/api/oauth/* — see mcp/README.md). A SECOND, additional way to get a
# token for /api/mcp: lets an OAuth-aware client (e.g. claude.ai's "Add
# custom connector") obtain one via browser login + consent instead of the
# manual generate-and-paste flow at /account. The existing McpApiToken flow
# is completely unaffected either way.
OAUTH_ISSUER_URL=                                # REQUIRED for the OAuth server to function (the /api/mcp manual-token
                                                  # path works fine without it). Must be a STABLE, externally-facing URL
                                                  # — e.g. https://vedicmojo.example.com — unlike
                                                  # VEDICMOJO_INTERNAL_BASE_URL above (that one is for this app's own
                                                  # internal self-calls). Never derive this from request headers: an
                                                  # OAuth issuer identity that drifted per-request would silently break
                                                  # client/token binding and the whole discovery chain. Local dev:
                                                  # http://localhost:3000 works (RFC 8414 allows an HTTP localhost
                                                  # issuer for testing).

# Docker: host path Postgres data is bind-mounted to (docker-compose.yml db.volumes)
POSTGRES_DATA_DIR=./data/postgres
