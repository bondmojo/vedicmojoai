generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chart {
  id            String        @id @default(uuid())
  clientName    String
  lagna         String
  yogakaraka    String?
  chartJson     Json
  chartHash     String        @unique
  moonLongitude Decimal       @db.Decimal(8, 4)
  birthDatetime DateTime      @db.Timestamptz
  createdAt     DateTime      @default(now()) @db.Timestamptz

  runs          PipelineRun[]

  @@map("chart")
}

// ─── Unified Chart ──────────────────────────────────────────────────
// Single table holding all chart data regardless of ingestion path.
// Column-per-domain JSONB: each domain stores its own structured data.
// Two ingestion paths:
//   source="compute" — deterministic engine output (Path A)
//   source="paste"   — ChartInputV1 JSON pasted by practitioner (Path B)

model UnifiedChart {
  id               String   @id @default(uuid())
  name             String
  source           String   // "compute" | "paste"

  // ─── Birth Input (compute path stores full BirthInput; paste path stores meta) ───
  birthInput       Json?    // BirthInput for compute, ChartMeta for paste

  // ─── Scalar index fields (for queries/display without parsing JSONB) ───
  lagna            String
  lagnaLongitude   Decimal  @db.Decimal(8, 4)
  moonLongitude    Decimal  @db.Decimal(8, 4)
  ayanamsa         Decimal  @db.Decimal(8, 4)
  birthDatetime    DateTime @db.Timestamptz
  // "male" | "female" | "other" — nullable, additive-only (no tightening step).
  // Pre-fills the matchmaking role picker only — never used to infer a
  // bride/groom role structurally. Backfilled from chartInputV1.meta.gender
  // by prisma/backfill-gender.ts. See design.md §OD-6.
  gender           String?

  // ─── Domain JSONB columns (compute engine output) ───
  planets          Json?    // PlanetPosition[]
  nakshatras       Json?    // NakshatraInfo[]
  divisionalCharts Json?    // DivisionalChart[]
  karakas          Json?    // CharaKaraka[]
  ashtakavarga     Json?    // AshtakavargaResult
  upagrahas        Json?    // Upagraha[]
  specialLagnas    Json?    // SpecialLagna[]
  arudhaPadas      Json?    // ArudhaPada[]
  relationships    Json?    // RelationshipGeometry
  shadbala         Json?    // ShadbalResult
  jaimini          Json?    // JaiminiGeometry
  bhavaBala        Json?    // BhavaBalaResult
  transits         Json?    // TransitAnalysis
  pindaStrength    Json?    // PindaStrengthEntry[]
  dashaTree        Json?    // Serialized DashaTree
  yogas            Json?    // Yoga[] — deterministic named-yoga catalogue (engine/compute/yogas.ts)

  // ─── AI pipeline input (ChartInputV1 format for Wave 1–4) ───
  // For source="paste": populated directly from pasted JSON
  // For source="compute": generated by mapper from computed domains
  chartInputV1     Json?

  // ─── Deduplication & provenance ───
  // Scoped per-user (not globally unique): two practitioners can each save a
  // chart for the same birth data (e.g. a shared client) without colliding.
  chartHash        String   // SHA-256 of canonical input
  sunriseMode      String   @default("precise")

  // ─── Timestamps ───
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  // ─── Relations ───
  pipelineRuns     PipelineRun[] @relation("UnifiedChartRuns")
  durationAnalyses DurationAnalysis[]
  matchesAsBride   CompatibilityMatch[] @relation("MatchBride")
  matchesAsGroom   CompatibilityMatch[] @relation("MatchGroom")

  // ─── Ownership ───
  // Tightened to required after prisma/backfill-owner.ts assigned every
  // existing row to an owner (Requirement 6.2's additive-then-tighten step 2).
  userId           String
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, chartHash])
  @@index([name])
  @@index([lagna])
  @@index([source])
  @@index([userId])
  @@map("unified_chart")
}

// ─── User Management ────────────────────────────────────────────────
// Auth.js (NextAuth v5) with @auth/prisma-adapter, using database-backed
// sessions and NO Credentials provider (providers: [] — @auth/core's
// assertConfig hard-errors on "Credentials + database sessions" together).
// See .kiro/specs/user-management/design.md for the integration note:
// custom routes in app/api/auth/* create/delete Session rows directly via
// the adapter rather than going through Auth.js's own signIn()/signOut().

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  mcpApiTokens        McpApiToken[]
  unifiedCharts       UnifiedChart[]
  compatibilityMatches CompatibilityMatch[]

  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]

  @@map("user")
}

// Auth.js PrismaAdapter standard shape — Account/VerificationToken are unused
// in v1 (no OAuth providers) but kept so the adapter works as documented and
// OAuth can be added later (still a Non-Goal) without a schema migration.
model Account {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime @db.Timestamptz

  @@index([userId])
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_token")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("password_reset_token")
}

model McpApiToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String?
  lastUsedAt DateTime? @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("mcp_api_token")
}

// ─── MCP OAuth authorization server ────────────────────────────────
// A second, additional way to get a token for POST /api/mcp — lets an
// OAuth-aware remote client (e.g. claude.ai's "Add custom connector") obtain
// one via browser redirect + login + consent instead of the manual
// generate-and-paste flow above (McpApiToken, unchanged). Distinct from the
// "OAuth" mentioned in the Account model's comment above, which refers to
// social-login providers (this app as an OAuth *client*) — this section
// makes this app an OAuth *server* issuing its own tokens to MCP clients.
// See .kiro/specs (mcp-oauth) / docs/HLD.md §3.9 for the full design.
//
// v1 simplification, documented deliberately: no refresh-token-family
// tracking. A replayed (already-rotated) refresh token is rejected on that
// one request but doesn't cascade-revoke the rest of its lineage.
model OAuthClient {
  id                      String   @id @default(uuid())
  clientId                String   @unique
  clientSecretHash        String? // always null in v1 — every dynamically-registered client is public/PKCE-only
  clientName              String?
  redirectUris            String[]
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  responseTypes           String[] @default(["code"])
  tokenEndpointAuthMethod String   @default("none")
  createdAt               DateTime @default(now()) @db.Timestamptz

  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]
  refreshTokens      OAuthRefreshToken[]

  @@map("oauth_client")
}

model OAuthAuthorizationCode {
  id                  String      @id @default(uuid())
  codeHash            String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String      @default("S256")
  resource            String?
  scope               String?
  expiresAt           DateTime    @db.Timestamptz
  usedAt              DateTime?   @db.Timestamptz
  createdAt           DateTime    @default(now()) @db.Timestamptz

  @@index([clientId])
  @@index([userId])
  @@map("oauth_authorization_code")
}

model OAuthAccessToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource  String?
  scope     String?
  expiresAt DateTime    @db.Timestamptz
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([clientId])
  @@map("oauth_access_token")
}

model OAuthRefreshToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String?
  expiresAt DateTime    @db.Timestamptz
  revokedAt DateTime?   @db.Timestamptz
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([clientId])
  @@map("oauth_refresh_token")
}

model PipelineRun {
  id              String        @id @default(uuid())
  chartId         String
  chart           Chart         @relation(fields: [chartId], references: [id])
  unifiedChartId  String?
  unifiedChart    UnifiedChart? @relation("UnifiedChartRuns", fields: [unifiedChartId], references: [id])
  runType         String
  queryTypes      String[]
  userQuery       String?
  isFollowup      Boolean       @default(false)
  parentRunId     String?
  parentRun       PipelineRun?  @relation("FollowupChain", fields: [parentRunId], references: [id])
  childRuns       PipelineRun[] @relation("FollowupChain")
  plannerOutput   Json?
  status          String        @default("queued")
  reportPath      String?
  totalTokenIn    Int           @default(0)
  totalTokenOut   Int           @default(0)
  totalCostUsd    Decimal       @default(0) @db.Decimal(10, 6)
  haltReason      Json?
  overrideApplied Boolean       @default(false)
  createdAt       DateTime      @default(now()) @db.Timestamptz
  completedAt     DateTime?     @db.Timestamptz

  waveOutputs     WaveOutput[]
  messages        RunMessage[]

  @@index([chartId])
  @@index([unifiedChartId])
  @@index([status])
  @@map("pipeline_run")
}

model Wave1Cache {
  id           String   @id @default(uuid())
  chartHash    String   @unique
  chartSummary String
  wave1Delta   Json
  dashaTree    Json
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@map("wave1_cache")
}

model WaveOutput {
  id            String      @id @default(uuid())
  runId         String
  run           PipelineRun @relation(fields: [runId], references: [id])
  agentId       String
  waveNumber    Int
  domain        String
  outputJson    Json?
  factSummary   String?
  promptVersion String
  modelId       String
  provider      String
  tokenIn       Int         @default(0)
  tokenOut      Int         @default(0)
  costUsd       Decimal     @default(0) @db.Decimal(10, 6)
  status        String      @default("running")
  errorMessage  String?
  startedAt     DateTime    @db.Timestamptz
  completedAt   DateTime?   @db.Timestamptz

  @@unique([runId, agentId])
  @@index([runId, domain])
  @@index([runId, waveNumber])
  @@map("wave_output")
}

model RunMessage {
  id        String      @id @default(uuid())
  runId     String
  run       PipelineRun @relation(fields: [runId], references: [id])
  role      String
  content   String
  agentId   String?
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([runId])
  @@map("run_message")
}

model ModelConfig {
  id            String   @id @default(uuid())
  waveId        String   @unique
  modelId       String
  provider      String
  temperature   Decimal  @db.Decimal(3, 2)
  maxTokens     Int
  promptVersion String
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@map("model_config")
}

model SavedChart {
  id            String   @id @default(uuid())
  name          String
  birthDate     String
  birthTime     String
  timezone      Decimal  @db.Decimal(4, 2)
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  sunriseMode   String   @default("precise")
  lagna         String
  lagnaLongitude Decimal @db.Decimal(8, 4)
  moonLongitude Decimal  @db.Decimal(8, 4)
  ayanamsa      Decimal  @db.Decimal(8, 4)
  chartData     Json
  dashaTree     Json?
  inputHash     String   @unique
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@index([name])
  @@index([lagna])
  @@map("saved_chart")
}

// ─── Duration Analysis ──────────────────────────────────────────────
// Stores a single duration-analysis pipeline run and all its agent outputs.
// Pipeline: Step 0 (slicer + transit overlay) → DA-1 → DA-2 (cond.) → DA-3
// status: queued | running | symptom_unmatched | done | failed | cancelled

model DurationAnalysis {
  id             String       @id @default(uuid())
  unifiedChartId String
  unifiedChart   UnifiedChart @relation(fields: [unifiedChartId], references: [id])
  dateFrom       DateTime     @db.Timestamptz
  dateTo         DateTime     @db.Timestamptz
  category       String       // "health" | "career" | "wealth" | "marriage" | "property" | "cashflow"
  userQuestion   String?
  symptoms       String?
  status         String       @default("queued") // queued | running | symptom_unmatched | done | failed | cancelled
  overrideProvider String?    // UI-selected LLM provider (anthropic|openai) — applied to all DA agents; null = use seeded ModelConfig
  overrideModel    String?    // UI-selected model id — applied to all DA agents; null = use seeded ModelConfig
  periodSlice    Json?        // DashaSlice[] — Step 0a output
  transitOverlay Json?        // TransitOverlay[] — Step 0b output, one entry per AD boundary
  foundationOutput Json?      // FoundationOutput — natal foundation sub-agents (Track 2); null = pre-feature run
  contextSummary String?      // ~500-token summary generated after DA-3 for efficient follow-ups
  errorMessage   String?      // failure reason when status="failed" (surfaced via SSE)
  overrideApplied Boolean     @default(false) // true if user overrode symptom_unmatched gate
  da1Output      Json?        // DA1Output
  da2Output      Json?        // DA2Output | null (null when no symptoms)
  da3Output      Json?        // DA3Output
  totalTokenIn   Int          @default(0)
  totalTokenOut  Int          @default(0)
  totalCostUsd   Decimal      @default(0) @db.Decimal(10, 6)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  messages DurationMessage[]

  @@index([unifiedChartId])
  @@index([status])
  @@map("duration_analysis")
}

model DurationMessage {
  id          String           @id @default(uuid())
  analysisId  String
  analysis    DurationAnalysis @relation(fields: [analysisId], references: [id])
  role        String           // "user" | "assistant"
  content     String
  agentId     String?          // "DA-3" for follow-ups, "chat" for manual
  focusPeriod String?          // e.g. "Jupiter MD / Saturn AD 2024-03" — period this message concerns
  tokenIn     Int              @default(0)
  tokenOut    Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz

  @@index([analysisId])
  @@map("duration_message")
}

// ─── Marriage Matchmaking ───────────────────────────────────────────
// Persisted Ashtakoota + Mangal Dosha result for a bride/groom chart pair.
// Roles are encoded structurally (brideChartId/groomChartId), never as a
// generic pair + role enum — see .kiro/specs/marriage-matchmaking/design.md
// §Prisma — CompatibilityMatch. Deleting either referenced UnifiedChart
// requires deleting dependent CompatibilityMatch rows first (no automatic
// cascade in Prisma) — see the DELETE /api/unified-charts/[id] handler.

model CompatibilityMatch {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])

  brideChartId  String
  brideChart    UnifiedChart @relation("MatchBride", fields: [brideChartId], references: [id])
  groomChartId  String
  groomChart    UnifiedChart @relation("MatchGroom", fields: [groomChartId], references: [id])

  label         String?
  gunaScore     Decimal      @db.Decimal(4, 1) // 0.5 steps fit exactly; NUMERIC is exact fixed-point
  // Denormalized off result.ashtakoota.verdict — same rationale as gunaScore
  // above: GET /api/matchmaking (list) needs this for the summary row and
  // must not fetch the full `result` JSONB just to read one nested string.
  // Every live write path (POST /api/matchmaking) sets this to a real
  // `MatchVerdict` value. The migration's backfill step for any pre-existing
  // row falls back to the literal string "unknown" (deliberately outside the
  // `MatchVerdict` union) only if `result.ashtakoota.verdict` were ever
  // missing/malformed — a defensive floor for data that should not exist,
  // not a value any code path produces going forward. UI verdict-badge
  // lookups already default unrecognized values to the "incomplete" style.
  verdict       String
  result        Json         // full MatchResult snapshot
  tablesVersion String

  createdAt     DateTime     @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([userId, createdAt]) // GET /api/matchmaking: WHERE userId = ? ORDER BY createdAt DESC
  @@index([brideChartId])
  @@index([groomChartId])
  @@map("compatibility_match")
}
