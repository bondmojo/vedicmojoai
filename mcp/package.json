{
  "name": "vedicmojo-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server exposing VedicMojoAI's deterministic compute + rubric knowledge to Claude Desktop (no paid LLM calls).",
  "type": "module",
  "bin": {
